{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Factory Acceptance Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "testRef",
    "environment",
    "measurements",
    "artifacts"
  ],
  "properties": {
    "apiVersion": {
      "const": "aifactory.engineering/v1alpha1"
    },
    "kind": {
      "const": "EvidenceBundle"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "startedAt",
        "endedAt"
      ],
      "properties": {
        "bundleId": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "endedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "testRef": {
      "type": "string",
      "minLength": 1
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "topologyRef",
        "versionMatrix"
      ],
      "properties": {
        "topologyRef": {
          "type": "string",
          "minLength": 1
        },
        "versionMatrix": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "configRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "uri"
        ],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "uri": {
            "type": "string",
            "minLength": 1
          },
          "checksum": {
            "type": "string"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collector",
        "collectedAt"
      ],
      "properties": {
        "collector": {
          "type": "string",
          "minLength": 1
        },
        "collectorVersion": {
          "type": "string"
        },
        "collectedAt": {
          "type": "string",
          "format": "date-time"
        },
        "assetRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "workloadRef": {
          "type": "string"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replayId",
        "inputDigest"
      ],
      "properties": {
        "replayId": {
          "type": "string",
          "minLength": 1
        },
        "inputDigest": {
          "type": "string",
          "minLength": 1
        },
        "parentBundleId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
