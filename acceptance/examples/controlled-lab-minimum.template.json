{
  "run_id": "CHANGE-ME-controlled-lab-001",
  "evidence_mode": "real-hardware",
  "topology_ref": "CHANGE-ME://lab/cell-or-node",
  "version_matrix": {
    "gpu": "CHANGE-ME",
    "driver": "CHANGE-ME",
    "cuda": "CHANGE-ME",
    "runtime": "CHANGE-ME",
    "model": "CHANGE-ME",
    "benchmark": "CHANGE-ME"
  },
  "asset_refs": [
    "CHANGE-ME://asset/gpu-node"
  ],
  "collector_version": "0.1",
  "timeout_seconds": 300,
  "not_evaluated": [
    {
      "layer": "fabric",
      "reason": "Minimum controlled-lab template: add live RDMA/NCCL tests when the lab supports multi-node fabric validation."
    }
  ],
  "gates": [
    {
      "id": "compute",
      "layer": "compute",
      "tests": [
        "gpu-health"
      ],
      "fail_closed": true
    },
    {
      "id": "runtime",
      "layer": "runtime",
      "tests": [
        "inference-slo"
      ],
      "depends_on": [
        "compute"
      ],
      "fail_closed": true
    }
  ],
  "tests": [
    {
      "collector": "gpu_csv",
      "command": [
        "bash",
        "-lc",
        "printf 'gpu_id,gpu_temp,power_w,sm_clock_mhz,ecc_uncorrected\\n'; nvidia-smi --query-gpu=index,temperature.gpu,power.draw,clocks.sm,ecc.errors.uncorrected.volatile.total --format=csv,noheader,nounits"
      ],
      "test": "../tests/gpu-health.json",
      "baselines": [],
      "gate_id": "compute",
      "bundle_id": "gpu-health-live"
    },
    {
      "collector": "inference",
      "command": [
        "CHANGE-ME-inference-benchmark-wrapper",
        "--json-summary"
      ],
      "test": "../tests/inference-slo.json",
      "baselines": [
        "controlled-lab-baselines/ttft-p95.template.json",
        "controlled-lab-baselines/tpot-p95.template.json",
        "controlled-lab-baselines/success-ratio.template.json"
      ],
      "gate_id": "runtime",
      "bundle_id": "inference-slo-live"
    }
  ]
}
